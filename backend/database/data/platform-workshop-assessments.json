        },
        {
          "titleFr": "Répondre à 5 questions de compréhension",
          "questions": [
            {
              "questionFr": "Où vont Sophie et Marc?",
              "answerFr": "Au parc"
            },
            {
              "questionFr": "Qui va au parc avec eux?",
              "answerFr": "Leur chien Félix / Félix"
            },
            {
              "questionFr": "De quelle couleur est le ballon?",
              "answerFr": "Rouge"
            },
            {
              "questionFr": "Que font-ils après le jeu?",
              "answerFr": "Ils mangent des sandwichs et boivent du jus"
            },
            {
              "questionFr": "Comment se sentent-ils à la fin?",
              "answerFr": "Fatigués mais heureux"
            }
          ],
          "variant": "highlight"
        }
      ]
